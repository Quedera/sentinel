[Unit]
Description=QUEDERA SENTINEL - Next.js app (user)
After=network.target
# Requires the SENTINEL Postgres container (sentinel-pg) to be running.
# It is published on 127.0.0.1:5433 and is set to restart unless-stopped.

[Service]
Type=simple
WorkingDirectory=/home/nortski101/.openclaw/workspace/sentinel
ExecStart=/usr/bin/node node_modules/next/dist/bin/next dev -H 0.0.0.0 -p 3002
Restart=always
RestartSec=5
Environment=PORT=3002
Environment=NODE_ENV=development
StandardOutput=append:/tmp/sentinel.log
StandardError=append:/tmp/sentinel.log

[Install]
WantedBy=default.target
