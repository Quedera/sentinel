// QUEDERA SENTINEL — Data model
//
// Postgres-first; swappable to Cosmos by changing `datasource db.provider`.
// Engagement status machine (per wireframe brief §15):
//
//   DRAFT
//     ↓
//   HIRE_REQUESTED
//     ↓
//   CONTRACT_UPLOADED
//     ↓
//   AWAITING_CONSULTANT
//     ↓
//   VIEWED
//     ↓
//   SIGNED
//     ↓
//   CONFIRMED ────→ ACTIVE ────→ COMPLETED
//
// Branches: CONTRACT_UPLOADED → DECLINED | EXPIRED (5-day no-response).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------

enum UserRole {
  CONSULTANT
  CLIENT
  ADMIN
}

// Verification lifecycle for the Sentinel Service Confirmation (decision #3).
// A user registers PENDING, signs the Service Confirmation on subscribe, and
// is promoted to VERIFIED by a QUEDERA administrator.
enum VerificationStatus {
  PENDING
  SERVICE_CONFIRMATION_SIGNED
  VERIFIED
  REJECTED
}

enum EngagementStatus {
  DRAFT
  HIRE_REQUESTED
  CONTRACT_UPLOADED
  AWAITING_CONSULTANT
  VIEWED
  SIGNED
  CONFIRMED
  DECLINED
  EXPIRED
  ACTIVE
  COMPLETED
  // Extension beyond the §15 brief: terminal state for a cancelled
  // engagement. Added for decision #5 (disputes & mid-engagement
  // cancellation). Flagged in README as an open point.
  TERMINATED
}

enum Sector {
  FINANCIAL_SERVICES
  TECHNOLOGY
  DEFENCE
  GOVERNMENT
  HEALTHCARE
  ENERGY
  OTHER
}

enum DayAvailability {
  AVAILABLE
  UNAVAILABLE
  BOOKED
}

enum AuditAction {
  CV_UPLOADED
  CV_REPLACED
  REFERENCE_ADDED
  REFERENCE_REMOVED
  RATE_CHANGED
  AVAILABILITY_CHANGED
  PROFILE_CREATED
  PROFILE_UPDATED
  SEARCH_PERFORMED
  PROFILE_VIEWED
  HIRE_REQUESTED
  CONTRACT_UPLOADED
  CONTRACT_VIEWED
  SIGNATURE_ATTEMPTED
  SIGNED
  DECLINED
  ENGAGEMENT_EXPIRED
  NOTIFICATION_SENT
  CONSULTANT_APPROVED
  CONSULTANT_REJECTED
  CONSULTANT_SUSPENDED
  USER_REGISTERED
  USER_LOGGED_IN
  SERVICE_CONFIRMATION_SIGNED
  VERIFICATION_GRANTED
  VERIFICATION_REJECTED
  INVOICE_ISSUED
  INVOICE_PAID
  INVOICE_VOIDED
  ENGAGEMENT_TERMINATED
  TERMINATION_PENALTY_APPLIED
}

// ---------- Core models ----------

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String?
  role          UserRole
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastLoginAt   DateTime?

  // Decision #3 — Sentinel Service Confirmation
  verificationStatus VerificationStatus @default(PENDING)

  consultant    Consultant?
  client        Client?
  auditEvents   AuditEvent[]

  serviceConfirmations ServiceConfirmation[]
  terminations        Termination[]         @relation("TerminationInitiator")

  @@index([email])
  @@index([verificationStatus])
}

model Consultant {
  id                  String   @id @default(cuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  fullName            String
  phone               String?
  location            String
  title               String
  yearsExperience     Int
  primarySector       Sector
  professionalSummary String
  skills              String[] // free-form list; canonical skills live in a separate enum table in v2
  dayRate             Int      // GBP

  cvBlobKey           String?  // pointer to object-store blob
  verified            Boolean  @default(false)
  profileComplete     Boolean  @default(false)

  // Decision #8 — search ordering. rating is a denormalised 0..5 score
  // maintained by the admin console; ratingCount is how many reviews it
  // aggregates. Refine post-launch.
  rating              Float    @default(0)
  ratingCount         Int      @default(0)

  // "Most recently active" for search ordering. Bumped on meaningful
  // activity (profile update, contract action, availability change).
  lastActiveAt        DateTime @default(now())

  references          Reference[]
  availabilityDays    AvailabilityDay[]
  engagements         Engagement[]
  invoices            Invoice[]

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([verified])
  @@index([primarySector])
}

model Reference {
  id           String     @id @default(cuid())
  consultantId String
  consultant   Consultant @relation(fields: [consultantId], references: [id], onDelete: Cascade)

  name         String
  organisation String
  position     String
  email        String
  phone        String

  createdAt    DateTime   @default(now())

  @@index([consultantId])
}

model Client {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  companyName  String
  contactName  String

  engagements  Engagement[]
  invoices     Invoice[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model AvailabilityDay {
  id           String         @id @default(cuid())
  consultantId String
  consultant   Consultant     @relation(fields: [consultantId], references: [id], onDelete: Cascade)

  date         DateTime       @db.Date
  status       DayAvailability

  @@unique([consultantId, date])
  @@index([date])
}

model Engagement {
  id                  String           @id @default(cuid())

  consultantId        String
  consultant          Consultant       @relation(fields: [consultantId], references: [id])

  clientId            String
  client              Client           @relation(fields: [clientId], references: [id])

  role                String
  startDate           DateTime         @db.Date
  endDate             DateTime         @db.Date
  estimatedDays       Int
  dayRate             Int
  estimatedValue      Int

  status              EngagementStatus @default(DRAFT)

  contractBlobKey     String?
  consultantDeadline  DateTime?
  signedAt            DateTime?
  declinedAt          DateTime?
  expiredAt           DateTime?

  // Decision #5 — disputes & mid-engagement cancellation
  terminatedAt        DateTime?
  terminationReason   String?
  terminationPenalty  Int      @default(0) // pence

  auditEvents         AuditEvent[]      @relation("EngagementAudit")
  invoices            Invoice[]
  termination         Termination?

  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@index([status])
  @@index([consultantId])
  @@index([clientId])
  @@index([consultantDeadline])
}

model AuditEvent {
  id           String      @id @default(cuid())
  timestamp    DateTime    @default(now())

  actorId      String
  actor        User        @relation(fields: [actorId], references: [id])

  engagementId String?
  engagement   Engagement? @relation("EngagementAudit", fields: [engagementId], references: [id], onDelete: Cascade)

  action       AuditAction
  resourceType String      // consultant | client | engagement | search | user
  resourceId   String
  details      String?     // free-form, e.g. "skills=Transformation;sector=Financial Services"

  @@index([timestamp])
  @@index([resourceType, resourceId])
  @@index([actorId])
  @@index([engagementId])
}

// ---------- Decision #3 — Sentinel Service Confirmation ----------
//
// A user signs the Service Confirmation when they subscribe. The signed
// record is retained so the audit trail can evidence consent.

model ServiceConfirmation {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  version     String   // document version, e.g. "2026-11-01"
  signedName  String
  signedAt    DateTime @default(now())
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([userId])
}

// ---------- Decision #4 — invoicing ----------
//
// Money amounts are stored in PENCE (integer) to avoid float drift.

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  OVERDUE
  VOID
}

model Invoice {
  id           String        @id @default(cuid())
  number       String        @unique
  engagementId String
  engagement   Engagement    @relation(fields: [engagementId], references: [id])
  clientId     String
  client       Client        @relation(fields: [clientId], references: [id])
  consultantId String
  consultant   Consultant    @relation(fields: [consultantId], references: [id])
  status       InvoiceStatus @default(DRAFT)
  currency     String        @default("GBP")
  subtotal     Int           // pence
  vat          Int           @default(0)
  total        Int           // pence
  issuedAt     DateTime?
  dueAt        DateTime?
  paidAt       DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([engagementId])
  @@index([status])
  @@index([clientId])
  @@index([consultantId])
}

// ---------- Decision #5 — termination & penalties ----------

enum TerminationSide {
  CLIENT
  CONSULTANT
}

model Termination {
  id            String          @id @default(cuid())
  // @unique — one termination record per engagement (Engagement.termination
  // is the one-to-one side).
  engagementId  String          @unique
  engagement    Engagement      @relation(fields: [engagementId], references: [id])
  initiatedById String
  initiatedBy   User            @relation("TerminationInitiator", fields: [initiatedById], references: [id])
  side          TerminationSide
  reason        String
  penalty       Int             // pence
  effectiveDate DateTime
  settledAt     DateTime?
  createdAt     DateTime        @default(now())

  @@index([engagementId])
  @@index([side])
}

// ---------- Cosmos migration note ----------
//
// To switch to Azure Cosmos DB (PostgreSQL API), change:
//   datasource db.provider = "postgresql"
// to:
//   datasource db.provider = "postgresql"
//   url      = env("COSMOS_URL")  // Azure Cosmos DB PostgreSQL API endpoint
//
// All models are relational and will work on Cosmos PostgreSQL API.
// If the team later needs Cosmos NoSQL API, the schema will need to be
// reshaped into container-based denormalised documents.
