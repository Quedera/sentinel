# QUEDERA SENTINEL — environment configuration
#
# Copy to `.env.local` for Next.js local dev. For production, inject via
# Azure Container Apps env / secrets.

# ---------------------------------------------------------------------------
# Database (Postgres for dev: `docker run -d --name sentinel-pg ... postgres:16-alpine`)
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://sentinel:***@localhost:5433/sentinel"

# ---------------------------------------------------------------------------
# Auth provider: noop | nextauth | entra
# ---------------------------------------------------------------------------
AUTH_PROVIDER="noop"

# ---------------------------------------------------------------------------
# E-signature provider: mock | docusign
# ---------------------------------------------------------------------------
EIG_PROVIDER="mock"

# ---------------------------------------------------------------------------
# Contract storage: local | azureblob
# ---------------------------------------------------------------------------
CONTRACT_STORAGE="local"
CONTRACT_STORAGE_LOCAL_DIR="./var/contracts"

# ---------------------------------------------------------------------------
# DocuSign (only required if EIG_PROVIDER=docusign)
# Get a free Developer sandbox at https://developers.docusign.com/
# ---------------------------------------------------------------------------
# Integration Key (client ID) from DocuSign admin → Apps and Keys
DOCUSIGN_INTEGRATION_KEY=""

# User ID we're impersonating via JWT (Service Integration user)
DOCUSIGN_USER_ID=""

# API Account ID (the DocuSign account the envelopes live under)
DOCUSIGN_ACCOUNT_ID=""

# RSA private key contents (PEM). For .env.local, paste with literal newlines
# or escape them as \n. For Azure, use multi-line secrets.
DOCUSIGN_RSA_PRIVATE_KEY=""

# Sandbox defaults — change for production
DOCUSIGN_BASE_PATH="https://demo.docusign.net/restapi"
DOCUSIGN_AUTH_SERVER="account-d.docusign.com"

# Optional — HMAC secret for Connect webhook signature verification
DOCUSIGN_WEBHOOK_HMAC_KEY=""

# ---------------------------------------------------------------------------
# Azure Blob Storage (only required if CONTRACT_STORAGE=azureblob)
# ---------------------------------------------------------------------------
AZURE_STORAGE_CONNECTION_STRING=""
AZURE_STORAGE_CONTAINER="sentinel-contracts"

# ---------------------------------------------------------------------------
# Notifications (decision #7 — email)
# ---------------------------------------------------------------------------
# Provider: console | smtp. Default is console, which prints every
# notification to stdout — no SMTP credentials needed for local development.
NOTIFY_PROVIDER="console"

# Only required when NOTIFY_PROVIDER=smtp
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
NOTIFY_FROM="QUEDERA SENTINEL <no-reply@sentinel.quedera.local>"
